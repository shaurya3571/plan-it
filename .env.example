# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings → Database → Connection string (session pooler for serverless)
DATABASE_URL=

# Leave unset (or anything but "live") and every provider below is mocked, so the
# build pipeline runs end to end with no keys. Set to "live" to use the real APIs,
# and then all of the keys below are required.
PROVIDERS=

# Google Cloud console → YouTube Data API v3
YOUTUBE_API_KEY=

# supadata.ai → dashboard (transcripts)
SUPADATA_API_KEY=

# Any OpenAI-compatible chat completions endpoint, e.g. https://integrate.api.nvidia.com/v1
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
# Planning and the placement test use ULTRA; per-lesson notes and quizzes use SUPER
NEMOTRON_MODEL_ULTRA=
NEMOTRON_MODEL_SUPER=
